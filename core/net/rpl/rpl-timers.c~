int should_send_dio(rpl_instance_t *instance) {
 
  //double exp_term = exp(-d_n * mean_w);
  double exp_term = fast_exp_neg(d_n);
  P_DIO = (1.0 - gamma) + gamma * E_res * exp_term;
  return (rand_prob < P_DIO);
}

